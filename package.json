{
  "name": "@koa/router",
  "description": "Router middleware for Koa.",
  "version": "15.7.1",
  "author": "Koa.js",
  "bugs": {
    "url": "https://github.com/koajs/router/issues",
    "email": "niftylettuce@gmail.com"
  },
  "contributors": [
    {
      "name": "@koajs"
    },
    {
      "name": "Imed Jaberi",
      "email": "imed-jaberi@outlook.com"
    }
  ],
  "peerDependencies": {
    "koa": "^2.0.0 || ^3.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "http-errors": "^2.0.1",
    "koa-compose": "^4.1.0",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "warn"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "require": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/koajs/router",
  "keywords": [
    "koa",
    "middleware",
    "route",
    "router"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koajs/router.git"
  },
  "scripts": {
    "benchmark": "node --require ts-node/register/transpile-only bench/run.ts",
    "benchmark:all": "node --require ts-node/register/transpile-only bench/make.ts",
    "setup": "bash scripts/setup/setup.sh",
    "check": "npm run lint -- --quiet && npm run ts:check && npm run ts:check:test",
    "validate": "npm run check && npm run test:all",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "npm run format -- --check",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:ci": "npm run lint",
    "test": "npm run test:all",
    "pretest:core": "npm run build",
    "test:core": "node --require ts-node/register/transpile-only --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:recipes": "node --require ts-node/register/transpile-only --test recipes/**/*.test.ts",
    "pretest:all": "npm run build",
    "test:all": "node --require ts-node/register/transpile-only --test test/unit/*.test.ts test/integration/*.test.ts recipes/**/*.test.ts",
    "pretest:coverage": "npm run build",
    "test:coverage": "node --require ts-node/register/transpile-only --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" test/unit/*.test.ts test/integration/*.test.ts recipes/**/*.test.ts",
    "ts:check": "tsc --noEmit --project tsconfig.typecheck.json",
    "ts:check:test": "tsc --noEmit --project tsconfig.test.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "prepack": "npm run build"
  }
}
